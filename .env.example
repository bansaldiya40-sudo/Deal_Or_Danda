# Turso Database Configuration (Required for persistent storage on Vercel)
# Create a free Turso database at: https://turso.tech
# Or via CLI: 
#   turso db create deal-or-danda
#   turso db show deal-or-danda --url
#   turso db tokens create deal-or-danda
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Note for Local Development:
# If TURSO_DATABASE_URL is left blank, the app automatically defaults 
# to a local SQLite file (deal_or_danda.db).
