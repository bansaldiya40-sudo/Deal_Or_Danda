# =====================================================================
# Deal or Danda — Production Bridge Configuration (for Vercel deployment)
# =====================================================================
# When deploying to Vercel and connecting to your local SQLite database:
# 1. Run `npm run bridge` in your local terminal to launch the bridge + tunnel.
# 2. Copy the generated values below into Vercel Project Settings -> Environment Variables.

BRIDGE_TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com
BRIDGE_SECRET_TOKEN=danda_sec_your_secret_token_here

# Note for Local Development:
# When running locally (npm run dev), the app connects directly to 
# C:\Deal_or_Danda\deal_or_danda.db with zero configuration needed.
